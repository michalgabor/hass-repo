#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Pocket Agents: run claude remote-control for the agent at the given index
# Usage: agent-run <index>
# ==============================================================================

index="${1:?Usage: agent-run <index>}"

name=$(bashio::config "agents[${index}].name")
title=$(bashio::config "agents[${index}].title" "${name}")
permission_mode=$(bashio::config "agents[${index}].permission_mode" "default")
spawn=$(bashio::config "agents[${index}].spawn" "same-dir")
dir="/config/agents/${name}"

# Export secrets as environment variables
count=$(bashio::config 'secrets|length')
for ((i = 0; i < count; i++)); do
    key=$(bashio::config "secrets[${i}].name")
    case "${key}" in
        ANTHROPIC_API_KEY | ANTHROPIC_AUTH_TOKEN | CLAUDE_CODE_OAUTH_TOKEN)
            # Remote Control requires claude.ai sign-in, these would break it
            bashio::log.warning "[${name}] Ignoring secret ${key}, Remote Control does not work with it."
            continue
            ;;
    esac
    export "${key}=$(bashio::config "secrets[${i}].value")"
done

if [[ ! -f /data/.claude/.credentials.json ]]; then
    bashio::log.warning "[${name}] Claude Code is not logged in."
    bashio::log.warning "[${name}] Open the Pocket Agents panel, run 'agent-setup', then restart the add-on."
    sleep 60
    exit 1
fi

cd "${dir}" || bashio::exit.nok "[${name}] Directory ${dir} does not exist."

args=(
    remote-control
    --name "${title}"
    --remote-control-session-name-prefix "${name}"
    --spawn "${spawn}"
    --permission-mode "${permission_mode}"
)
# --capacity cannot be combined with --spawn=session
if [[ "${spawn}" != "session" ]] && bashio::config.has_value "agents[${index}].capacity"; then
    args+=(--capacity "$(bashio::config "agents[${index}].capacity")")
fi

bashio::log.info "[${name}] Starting: claude ${args[*]}"

stopping=0
claude "${args[@]}" > >(sed -u "s/^/[${name}] /") 2>&1 &
child=$!
trap 'stopping=1; kill -TERM "${child}" 2>/dev/null' TERM INT

wait "${child}"
rc=$?
# A trapped signal interrupts wait, so wait until the process really exits
while kill -0 "${child}" 2>/dev/null; do
    wait "${child}"
    rc=$?
done

if [[ "${stopping}" -eq 0 ]]; then
    bashio::log.warning "[${name}] claude remote-control exited with code ${rc}, restarting in 30 s."
    sleep 30
fi

exit "${rc}"
